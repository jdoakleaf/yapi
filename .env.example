# =============================================================================
# Yapı Platform — Environment Variables
# =============================================================================
# Bu dosyayı kopyalayıp .env.local olarak kaydedin ve değerleri doldurun.
# Gerçek secret değerlerini ASLA Git'e göndermeyin.
# =============================================================================

# --- Veritabanı ---
DATABASE_URL="postgresql://user:password@localhost:5432/yapi_platform?schema=public"

# --- Uygulama ---
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"

# --- Auth (Faz 3'te yapılandırılacak) ---
# AUTH_SECRET="buraya-güvenli-rastgele-bir-string-giriniz"

# --- E-posta (Faz 10'da yapılandırılacak) ---
# SMTP_HOST=""
# SMTP_PORT=""
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM=""

# --- Medya Depolama (Faz 4'te yapılandırılacak) ---
# STORAGE_PROVIDER="local"
# S3_BUCKET=""
# S3_REGION=""
# S3_ACCESS_KEY=""
# S3_SECRET_KEY=""
