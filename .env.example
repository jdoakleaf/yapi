# =============================================================================
# Yapı Platform — Environment Variables
# =============================================================================
# Bu dosyayı kopyalayıp .env.local olarak kaydedin ve değerleri doldurun.
# Gerçek secret değerlerini ASLA Git'e göndermeyin.
# =============================================================================

# --- Veritabanı ---
# Geliştirme: embedded-postgres (port 5433, pnpm db:start ile başlar)
# Üretim: Harici PostgreSQL sunucusu (port 5432)
DATABASE_URL="postgresql://yapi_user:GUCLU_PAROLA@localhost:5432/yapi_platform?schema=public"

# --- Uygulama ---
NEXT_PUBLIC_APP_URL="https://your-domain.com"
NODE_ENV="production"

# Opsiyonel: build versiyonu (CI/CD'de otomatik set edilir)
# APP_VERSION="1.0.0"

# --- Auth ---
# Üretmek için: openssl rand -base64 32
AUTH_SECRET="BURAYA-EN-AZ-32-KARAKTER-RASTGELE-STRING"

# --- E-posta (SMTP) ---
# Teklif bildirimleri ve sistem e-postaları için
SMTP_HOST="smtp.example.com"
SMTP_PORT="587"
SMTP_USER="noreply@your-domain.com"
SMTP_PASS="smtp-parola"
SMTP_FROM="Yapı Platform <noreply@your-domain.com>"
# Yeni talep geldiğinde bildirim e-postası alacak admin adresi
ADMIN_EMAIL="admin@your-domain.com"

# --- Medya Depolama ---
# Yerel depolama (varsayılan):
STORAGE_PROVIDER="local"

# S3 uyumlu depolama (Faz 15 — opsiyonel):
# STORAGE_PROVIDER="s3"
# S3_BUCKET="yapi-platform-media"
# S3_REGION="eu-central-1"
# S3_ACCESS_KEY="AKIAXXXXXXXXXXXXXXXX"
# S3_SECRET_KEY="xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
# S3_ENDPOINT=""  # MinIO vb. için: "https://minio.example.com"

# --- Güvenlik ---
# Üretimde HTTPS zorunlu. HSTS başlığı next.config.ts'de etkin.
# Rate limiting: Şu an in-memory Map. Üretimde Redis önerilir.
# REDIS_URL="redis://localhost:6379"
