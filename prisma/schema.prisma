// Yapı Platform — Prisma Schema
// Veritabanı: PostgreSQL
// ORM: Prisma 5.22.0
//
// Tüm tablolar PROJECT_SPECIFICATION.md bölüm 10.3'e göre tasarlanmıştır.
// UUID primary key, UTC tarihler, soft delete tercih edilir.

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.1.x", "linux-x64-openssl-1.1.x", "linux-x64-openssl-3.0.x"]
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ===========================================================================
// ENUM'LAR
// ===========================================================================

enum ContentStatus {
  DRAFT
  REVIEW
  PUBLISHED
  ARCHIVED
}

enum UserRole {
  SUPER_ADMIN
  ADMIN
  EDITOR
  SALES
}

enum WorkModel {
  LABOR_ONLY
  MATERIAL_AND_LABOR
  TURNKEY
  UNDECIDED
}

enum CustomerType {
  INDIVIDUAL
  CORPORATE
}

enum LeadStatus {
  NEW
  CONTACTED
  QUOTING
  QUOTE_SENT
  WON
  LOST
  ARCHIVED
}

enum HttpStatus {
  REDIRECT_301
  REDIRECT_302
}

enum StorageProvider {
  LOCAL
  S3
}

// ===========================================================================
// KULLANICI VE YETKİ YÖNETİMİ
// ===========================================================================

model User {
  id           String    @id @default(uuid())
  name         String
  email        String    @unique
  passwordHash String    @map("password_hash")
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  // İlişkiler
  userRoles     UserRole_[]
  sessions      Session[]
  auditLogs     AuditLog[]
  leadNotes     LeadNote[]
  media         Media[]
  pages         Page[]         @relation("PageCreatedBy")
  pagesUpdated  Page[]         @relation("PageUpdatedBy")
  services      Service[]      @relation("ServiceCreatedBy")
  servicesUpd   Service[]      @relation("ServiceUpdatedBy")
  projects      Project[]      @relation("ProjectCreatedBy")
  projectsUpd   Project[]      @relation("ProjectUpdatedBy")
  blogPosts     BlogPost[]
  themeSettings ThemeSetting[]
  siteSettings  SiteSetting[]

  @@map("users")
}

model Role {
  id          String  @id @default(uuid())
  name        String
  key         String  @unique
  description String? @db.Text

  userRoles       UserRole_[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  key         String  @unique
  description String? @db.Text

  rolePermissions RolePermission[]

  @@map("permissions")
}

model UserRole_ {
  userId String @map("user_id")
  roleId String @map("role_id")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model RolePermission {
  roleId       String @map("role_id")
  permissionId String @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model Session {
  id        String   @id @default(uuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("sessions")
}

// ===========================================================================
// MEDYA
// ===========================================================================

model Media {
  id               String          @id @default(uuid())
  storageProvider  StorageProvider @default(LOCAL) @map("storage_provider")
  storageKey       String          @map("storage_key")
  originalFilename String          @map("original_filename")
  mimeType         String          @map("mime_type")
  fileSize         Int             @map("file_size")
  width            Int?
  height           Int?
  altText          String?         @map("alt_text")
  title            String?
  caption          String?
  uploadedBy       String?         @map("uploaded_by")
  createdAt        DateTime        @default(now()) @map("created_at")

  uploader User? @relation(fields: [uploadedBy], references: [id], onDelete: SetNull)

  // Ters ilişkiler
  serviceCategories ServiceCategory[]
  serviceCards      Service[]         @relation("ServiceCardMedia")
  serviceCovers     Service[]         @relation("ServiceCoverMedia")
  projectCovers     Project[]
  projectMedia      ProjectMedia[]
  blogPosts         BlogPost[]
  testimonials      Testimonial[]
  leadAttachments   LeadAttachment[]
  pageOgMedia       Page[]

  @@index([storageKey])
  @@map("media")
}

// ===========================================================================
// SAYFALAR VE BLOKLAR
// ===========================================================================

model Page {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  excerpt      String?       @db.Text
  status       ContentStatus @default(DRAFT)
  templateKey  String?       @map("template_key")
  seoTitle     String?       @map("seo_title")
  seoDesc      String?       @map("seo_description")
  ogMediaId    String?       @map("og_media_id")
  canonicalUrl String?       @map("canonical_url")
  publishedAt  DateTime?     @map("published_at")
  createdBy    String?       @map("created_by")
  updatedBy    String?       @map("updated_by")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  ogMedia  Media?        @relation(fields: [ogMediaId], references: [id], onDelete: SetNull)
  creator  User?         @relation("PageCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater  User?         @relation("PageUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  sections PageSection[]

  @@index([slug])
  @@index([status])
  @@map("pages")
}

model PageSection {
  id          String   @id @default(uuid())
  pageId      String   @map("page_id")
  blockType   String   @map("block_type")
  sortOrder   Int      @default(0) @map("sort_order")
  isActive    Boolean  @default(true) @map("is_active")
  contentJson Json     @map("content_json")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  page Page @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, sortOrder])
  @@map("page_sections")
}

// ===========================================================================
// HİZMET KATEGORİLERİ VE HİZMETLER
// ===========================================================================

model ServiceCategory {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  imageMediaId String?  @map("image_media_id")
  sortOrder    Int      @default(0) @map("sort_order")
  isActive     Boolean  @default(true) @map("is_active")
  seoTitle     String?  @map("seo_title")
  seoDesc      String?  @map("seo_description")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  image    Media?    @relation(fields: [imageMediaId], references: [id], onDelete: SetNull)
  services Service[]

  @@index([slug])
  @@index([sortOrder])
  @@map("service_categories")
}

model Service {
  id               String        @id @default(uuid())
  categoryId       String        @map("category_id")
  title            String
  slug             String        @unique
  shortDescription String?       @db.Text @map("short_description")
  content          String?       @db.Text
  cardMediaId      String?       @map("card_media_id")
  coverMediaId     String?       @map("cover_media_id")
  status           ContentStatus @default(DRAFT)
  isFeatured       Boolean       @default(false) @map("is_featured")
  sortOrder        Int           @default(0) @map("sort_order")
  seoTitle         String?       @map("seo_title")
  seoDesc          String?       @map("seo_description")
  publishedAt      DateTime?     @map("published_at")
  createdBy        String?       @map("created_by")
  updatedBy        String?       @map("updated_by")
  createdAt        DateTime      @default(now()) @map("created_at")
  updatedAt        DateTime      @updatedAt @map("updated_at")

  category        ServiceCategory  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  cardMedia       Media?           @relation("ServiceCardMedia", fields: [cardMediaId], references: [id], onDelete: SetNull)
  coverMedia      Media?           @relation("ServiceCoverMedia", fields: [coverMediaId], references: [id], onDelete: SetNull)
  creator         User?            @relation("ServiceCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater         User?            @relation("ServiceUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  projectServices ProjectService[]
  faqs            FAQ[]
  leads           Lead[]

  @@index([slug])
  @@index([categoryId])
  @@index([status])
  @@index([isFeatured])
  @@map("services")
}

// ===========================================================================
// PROJELER
// ===========================================================================

model Project {
  id             String        @id @default(uuid())
  title          String
  slug           String        @unique
  summary        String?       @db.Text
  description    String?       @db.Text
  locationLabel  String?       @map("location_label")
  projectType    String?       @map("project_type")
  completionDate DateTime?     @map("completion_date")
  status         ContentStatus @default(DRAFT)
  isFeatured     Boolean       @default(false) @map("is_featured")
  coverMediaId   String?       @map("cover_media_id")
  seoTitle       String?       @map("seo_title")
  seoDesc        String?       @map("seo_description")
  publishedAt    DateTime?     @map("published_at")
  createdBy      String?       @map("created_by")
  updatedBy      String?       @map("updated_by")
  createdAt      DateTime      @default(now()) @map("created_at")
  updatedAt      DateTime      @updatedAt @map("updated_at")

  coverMedia      Media?           @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  creator         User?            @relation("ProjectCreatedBy", fields: [createdBy], references: [id], onDelete: SetNull)
  updater         User?            @relation("ProjectUpdatedBy", fields: [updatedBy], references: [id], onDelete: SetNull)
  projectServices ProjectService[]
  projectMedia    ProjectMedia[]

  @@index([slug])
  @@index([status])
  @@index([isFeatured])
  @@map("projects")
}

model ProjectService {
  projectId String @map("project_id")
  serviceId String @map("service_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@map("project_services")
}

model ProjectMedia {
  id        String  @id @default(uuid())
  projectId String  @map("project_id")
  mediaId   String  @map("media_id")
  caption   String?
  altText   String? @map("alt_text")
  sortOrder Int     @default(0) @map("sort_order")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  media   Media   @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@index([projectId, sortOrder])
  @@map("project_media")
}

// ===========================================================================
// BLOG
// ===========================================================================

model BlogPost {
  id           String        @id @default(uuid())
  title        String
  slug         String        @unique
  excerpt      String?       @db.Text
  content      String?
  coverMediaId String?       @map("cover_media_id")
  authorId     String?       @map("author_id")
  status       ContentStatus @default(DRAFT)
  publishedAt  DateTime?     @map("published_at")
  seoTitle     String?       @map("seo_title")
  seoDesc      String?       @map("seo_description")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  coverMedia Media? @relation(fields: [coverMediaId], references: [id], onDelete: SetNull)
  author     User?  @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([slug])
  @@index([status])
  @@map("blog_posts")
}

// ===========================================================================
// MÜŞTERİ YORUMLARI
// ===========================================================================

model Testimonial {
  id                String   @id @default(uuid())
  displayName       String   @map("display_name")
  companyOrLocation String?  @map("company_or_location")
  quote             String   @db.Text
  rating            Int?
  mediaId           String?  @map("media_id")
  isPublished       Boolean  @default(false) @map("is_published")
  sortOrder         Int      @default(0) @map("sort_order")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  media Media? @relation(fields: [mediaId], references: [id], onDelete: SetNull)

  @@index([isPublished, sortOrder])
  @@map("testimonials")
}

// ===========================================================================
// SSS
// ===========================================================================

model FAQ {
  id          String   @id @default(uuid())
  question    String   @db.Text
  answer      String   @db.Text
  serviceId   String?  @map("service_id")
  sortOrder   Int      @default(0) @map("sort_order")
  isPublished Boolean  @default(false) @map("is_published")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  service Service? @relation(fields: [serviceId], references: [id], onDelete: SetNull)

  @@index([serviceId])
  @@map("faqs")
}

// ===========================================================================
// MENÜ YÖNETİMİ
// ===========================================================================

model Menu {
  id       String  @id @default(uuid())
  name     String
  key      String  @unique
  isActive Boolean @default(true) @map("is_active")

  items MenuItem[]

  @@map("menus")
}

model MenuItem {
  id        String  @id @default(uuid())
  menuId    String  @map("menu_id")
  parentId  String? @map("parent_id")
  label     String
  url       String
  target    String  @default("_self")
  sortOrder Int     @default(0) @map("sort_order")
  isActive  Boolean @default(true) @map("is_active")

  menu     Menu       @relation(fields: [menuId], references: [id], onDelete: Cascade)
  parent   MenuItem?  @relation("MenuItemChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children MenuItem[] @relation("MenuItemChildren")

  @@index([menuId, sortOrder])
  @@map("menu_items")
}

// ===========================================================================
// SITE VE TEMA AYARLARI
// ===========================================================================

model SiteSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  valueJson Json     @map("value_json")
  updatedBy String?  @map("updated_by")
  updatedAt DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("site_settings")
}

model ThemeSetting {
  id             String   @id @default(uuid())
  themeKey       String   @unique @map("theme_key")
  tokensJson     Json     @map("tokens_json")
  typographyJson Json?    @map("typography_json")
  updatedBy      String?  @map("updated_by")
  updatedAt      DateTime @updatedAt @map("updated_at")

  updater User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@map("theme_settings")
}

// ===========================================================================
// TEKLİF VE İLETİŞİM TALEPLERİ
// ===========================================================================

model Lead {
  id                   String       @id @default(uuid())
  referenceCode        String       @unique @map("reference_code")
  fullName             String       @map("full_name")
  phone                String
  email                String?
  customerType         CustomerType @map("customer_type")
  serviceId            String?      @map("service_id")
  workModel            WorkModel    @map("work_model")
  city                 String
  district             String?
  message              String?      @db.Text
  status               LeadStatus   @default(NEW)
  assignedTo           String?      @map("assigned_to")
  privacyNoticeVersion String?      @map("privacy_notice_version")
  consentMetadata      Json?        @map("consent_metadata")
  sourcePage           String?      @map("source_page")
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")

  service     Service?         @relation(fields: [serviceId], references: [id], onDelete: SetNull)
  attachments LeadAttachment[]
  notes       LeadNote[]

  @@index([status])
  @@index([referenceCode])
  @@index([createdAt])
  @@map("leads")
}

model LeadAttachment {
  id      String @id @default(uuid())
  leadId  String @map("lead_id")
  mediaId String @map("media_id")

  lead  Lead  @relation(fields: [leadId], references: [id], onDelete: Cascade)
  media Media @relation(fields: [mediaId], references: [id], onDelete: Restrict)

  @@map("lead_attachments")
}

model LeadNote {
  id        String   @id @default(uuid())
  leadId    String   @map("lead_id")
  userId    String   @map("user_id")
  note      String   @db.Text
  createdAt DateTime @default(now()) @map("created_at")

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId])
  @@map("lead_notes")
}

// ===========================================================================
// YÖNLENDİRMELER VE DENETİM
// ===========================================================================

model Redirect {
  id              String     @id @default(uuid())
  sourcePath      String     @unique @map("source_path")
  destinationPath String     @map("destination_path")
  httpStatus      HttpStatus @default(REDIRECT_301) @map("http_status")
  isActive        Boolean    @default(true) @map("is_active")
  createdAt       DateTime   @default(now()) @map("created_at")
  updatedAt       DateTime   @updatedAt @map("updated_at")

  @@index([sourcePath, isActive])
  @@map("redirects")
}

model AuditLog {
  id           String   @id @default(uuid())
  userId       String?  @map("user_id")
  action       String
  entityType   String   @map("entity_type")
  entityId     String?  @map("entity_id")
  summary      String?  @db.Text
  metadataJson Json?    @map("metadata_json")
  ipHash       String?  @map("ip_hash")
  createdAt    DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
